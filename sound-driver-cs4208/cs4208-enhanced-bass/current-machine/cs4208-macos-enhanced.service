[Unit]
Description=CS4208 enhanced bass with macOS DSP dynamics
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
PartOf=pipewire.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/sound_driver/cs4208-macos-enhanced
ExecStart=/usr/bin/python3 -u %h/sound_driver/cs4208-macos-enhanced/live.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=12
LimitCORE=0
Environment="PIPEWIRE_PROPS={ module.rt = false }"

[Install]
WantedBy=pipewire.service
