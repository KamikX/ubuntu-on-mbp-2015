[Unit]
Description=CS4208 full macOS DSP experimental speakers
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
PartOf=pipewire.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/sound_driver/cs4208-macos-chain
ExecStart=/usr/bin/python3 -u %h/sound_driver/cs4208-macos-chain/live.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=12
LimitCORE=0
Environment="PIPEWIRE_PROPS={ module.rt = false }"

[Install]
WantedBy=pipewire.service
